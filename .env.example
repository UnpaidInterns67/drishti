# Create .env from this file. Never commit the real password.
APP_ENV=development
BOOTSTRAP_OFFICER_USERNAME=admin
BOOTSTRAP_OFFICER_PASSWORD=replace-with-a-random-password-of-14-or-more-characters
AUTH_SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=300
API_RATE_LIMIT=300
API_RATE_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=25000000

# false is only for an HTTP localhost demo. Production HTTPS must use true.
AUTH_COOKIE_SECURE=false
REQUIRE_HTTPS=false
DATA_VOLUME_ENCRYPTED=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DRISHTI_DOMAIN=drishti.example.gov.in
